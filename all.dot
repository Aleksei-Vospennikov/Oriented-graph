digraph All {
    rankdir=LR;
    compound=true;
    node [shape=record, style="rounded,filled"];

    subgraph cluster_0 {
        label="Original";
        style=bold;
        g0_n0 [label="{ 0 | 10 }", fillcolor="antiquewhite1"];
        g0_n1 [label="{ 1 | 20 }", fillcolor="antiquewhite1"];
        g0_n2 [label="{ 2 | 30 }", fillcolor="antiquewhite1"];
        g0_n3 [label="{ 3 | 40 }", fillcolor="antiquewhite1"];
